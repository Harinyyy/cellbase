# ---- MongoDB ----
MONGODB_URI=mongodb://127.0.0.1:27017/cellculture_db
MONGODB_PORT=27017

# ---- Redis ----
REDIS_PORT=6379

# ---- Backend ----
BACKEND_PORT=4000

# ---- Auth (JWT) ----
# Generate a real secret locally, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# ---- Frontend ----
FRONTEND_PORT=3000
